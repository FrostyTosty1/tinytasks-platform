apiVersion: kubeadm.k8s.io/v1beta4
kind: JoinConfiguration

discovery:
  bootstrapToken:
    apiServerEndpoint: "10.0.0.10:6443"
    token: {{ hostvars['cp'].join_token_result.stdout }}
    caCertHashes:
      - {{ hostvars['cp'].ca_cert_hash }}

nodeRegistration:
  name: {{ ansible_facts['hostname'] }}
  criSocket: "unix:///var/run/containerd/containerd.sock"
  kubeletExtraArgs:
    - name: node-ip
      value: {{ expected_private_ips[ansible_facts['hostname']] }}